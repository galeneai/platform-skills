{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Galene app project context",
  "type": "object",
  "required": ["schema_version", "tenant", "registry"],
  "properties": {
    "schema_version": { "const": 1 },
    "tenant": {
      "type": "object",
      "required": ["slug", "environment"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "registry": {
      "type": "object",
      "required": ["choice"],
      "properties": {
        "choice": { "type": "string", "enum": ["external-owner", "integrated"] },
        "source_slug": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "choice": { "const": "external-owner" } }, "required": ["choice"] },
          "then": { "anyOf": [{ "required": ["source_slug"] }, { "required": ["endpoint"] }] }
        }
      ]
    }
  },
  "additionalProperties": false
}
